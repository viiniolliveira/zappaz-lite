# Desenvolvimento local. Copie para .env na raiz.
# Produção: use docker/.env.compose.example ou docker/.env.dockerfile.example.
# Origem do Vite.
APP_URL=http://localhost:5173

# Segredo de assinatura dos tokens. Gere com: openssl rand -hex 32
CLIENT_SECRET=replace-with-a-unique-random-secret

# Conexão local usada pela API e pelo Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Somente desenvolvimento: senha do Drizzle Gateway (http://localhost:4983).
MASTERPASS=replace-with-a-unique-random-password

# Primeiro startup: cria o administrador somente quando não há usuários.
# Remova as credenciais após criar o administrador. Não execute db:seed em produção.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Recuperação: defina uma nova senha, descomente e reinicie; remova após o reset.
# ADMIN_RESET_PASSWORD=true

# Retenção em dias: inteiro positivo ou off para desativar a limpeza automática.
MESSAGE_RETENTION_DAYS=90
WEBHOOK_LOG_RETENTION_DAYS=1

# Persistência privada de mídias: o padrão da aplicação é false; este exemplo ativa fs.
# Drivers disponíveis: fs (disco local) ou s3.
MEDIA_STORAGE_ENABLED=true
MEDIA_STORAGE_DRIVER=fs

# Usado pelo driver fs; no Compose de produção o caminho é definido internamente.
MEDIA_STORAGE_PATH=./storage/media

# S3: ative MEDIA_STORAGE_ENABLED e defina MEDIA_STORAGE_DRIVER=s3.
# Bucket, região e credenciais são obrigatórios somente ao usar S3.
S3_BUCKET=
S3_REGION=

# Opcional para AWS; informe o endpoint do provedor para S3 compatível.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SUPPORTS_ACL=false

# Maximum upload/download size per file, in MiB (default: 25).
MEDIA_MAX_FILE_SIZE_MB=25
