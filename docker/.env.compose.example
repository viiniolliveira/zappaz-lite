# Produção com Compose/Dokploy: configurações usadas em runtime, nunca no build.
# No Dokploy, informe os valores em Environment; nos scripts locais, copie para .env na raiz.
# Substitua os placeholders antes do deploy. Não versione o arquivo com valores reais.
# As opções comentadas abaixo documentam valores fixos ou não repassados pelo Compose atual.

# Aplicação e segurança

# Origem pública HTTPS obrigatória, sem caminho, query ou fragmento; também define CORS, MCP e WSS.
APP_URL=https://zappaz.example.com

# Segredo estável do Better Auth e dos cursores; gere com openssl rand -hex 32.
# Trocar o valor afeta cookies assinados e cursores; não reutilize a senha do banco.
CLIENT_SECRET=replace-with-a-random-secret

# Modo de execução: development, test ou production. Fixado em production pelo Compose.
# Alterar esta linha não muda o serviço; seria necessário editar o YAML, não recomendado em produção.
# NODE_ENV=production

# Porta interna HTTP da API, de 1 a 65535; fixada em 3001 pelo Compose e pelo healthcheck.
# Não publica uma porta no host. Alterar exige ajustar o YAML, healthcheck e destino do proxy.
# PORT=3001

# Confia em X-Real-IP somente se true; padrão false. X-Forwarded-For é ignorado.
# Não é repassada pelo Compose atual: para usar, adicione TRUST_PROXY ao environment de app no YAML.
# Ative somente com acesso direto bloqueado e proxy confiável que sobrescreva X-Real-IP.
# TRUST_PROXY=false

# Banco de dados

# Senha do PostgreSQL e da conexão da API; gere OUTRO valor com openssl rand -hex 32.
# Use hexadecimal, pois a senha entra na URL. Alterar não troca a senha de um volume já inicializado.
POSTGRES_PASSWORD=replace-with-a-random-hexadecimal-password

# Conexão PostgreSQL da API/Prisma, montada internamente pelo Compose com POSTGRES_PASSWORD.
# Não preencha no Dokploy: usuário, banco e host são postgres; porta interna 5432.
# DATABASE_URL=postgresql://postgres:SENHA_HEXADECIMAL@postgres:5432/postgres

# Administrador

# Email do primeiro administrador; obrigatório junto da senha quando o banco não tem usuários.
# Remova as credenciais do ambiente após a criação; reinícios normais não alteram a conta existente.
ADMIN_EMAIL=admin@example.com

# Senha inicial do administrador, de 8 a 128 caracteres; substitua por uma senha forte e única.
# Também define a nova senha ao usar ADMIN_RESET_PASSWORD=true.
ADMIN_PASSWORD=replace-with-a-strong-password

# Recuperação de acesso: true redefine a senha do administrador indicado acima a cada startup.
# Padrão false; exige email de administrador existente e nova senha. Desative após recuperar o acesso.
ADMIN_RESET_PASSWORD=false

# Retenção automática

# Dias de retenção das mensagens, miniaturas e mídias associadas; inteiro positivo ou off.
# Padrão 90; off desativa somente a retenção automática, não as exclusões explícitas.
MESSAGE_RETENTION_DAYS=90

# Dias de retenção dos logs de webhook; inteiro positivo ou off para manter indefinidamente.
# Padrão 1; a limpeza automática é executada a cada hora.
WEBHOOK_LOG_RETENTION_DAYS=1

# Mídias e armazenamento privado

# Limite por arquivo de upload/download em MiB; inteiro positivo, padrão 25 (1 MiB = 1.048.576 bytes).
# Ajuste também o proxy. No download Baileys, a conferência ocorre após acumular o arquivo em memória.
MEDIA_MAX_FILE_SIZE_MB=25

# Persiste arquivos completos na primeira solicitação de download; true ou false, padrão false.
# Desativado mantém metadados/miniaturas no banco e recupera o arquivo pelo Baileys sob demanda.
MEDIA_STORAGE_ENABLED=false

# Driver de persistência: fs (volume local media-data) ou s3 (bucket privado); padrão fs.
MEDIA_STORAGE_DRIVER=fs

# Raiz do driver fs, fixada pelo Compose no volume media-data; não é configurável por este arquivo.
# Para mudar, ajuste environment e volumes no YAML e planeje a migração dos arquivos existentes.
# MEDIA_STORAGE_PATH=/app/storage/media

# S3 e provedores compatíveis
# Para ativar, use MEDIA_STORAGE_ENABLED=true e MEDIA_STORAGE_DRIVER=s3.
# Valores vazios são considerados ausentes; mantenha credenciais se houver arquivos S3 a excluir.

# Nome do bucket privado; obrigatório quando a persistência S3 está ativa.
S3_BUCKET=

# Região do bucket, obrigatória com S3 ativo; na AWS use a região real, no Cloudflare R2 use auto.
S3_REGION=

# Endpoint HTTP/HTTPS do provedor compatível; opcional na AWS, que usa o endpoint padrão da região.
# Exemplo R2: https://ACCOUNT_ID.r2.cloudflarestorage.com. Não inclua credenciais na URL.
S3_ENDPOINT=

# Identificador da credencial S3; obrigatório com persistência S3 ativa, apenas no backend.
S3_ACCESS_KEY_ID=

# Segredo da credencial S3; obrigatório com persistência S3 ativa. Não use chaves públicas do provedor.
S3_SECRET_ACCESS_KEY=

# Usa o bucket no caminho da URL em vez do hostname; true ou false, padrão false.
# Provedores compatíveis, como Supabase Storage, podem exigir true.
S3_FORCE_PATH_STYLE=false

# Informa se o provedor aceita ACL por objeto; true ou false, padrão false.
# Deixe false para R2, Supabase e buckets AWS com object ownership enforced.
S3_SUPPORTS_ACL=false

# MASTERPASS é exclusivo do Drizzle Gateway no Compose de desenvolvimento; não é usado em produção.
# Não há variáveis VITE_* nem token administrativo global. Consulte docs/environment.md.
