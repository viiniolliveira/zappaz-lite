{
  "name": "zappaz-lite",
  "private": true,
  "version": "0.1.0",
  "description": "Full-stack WhatsApp API platform with Hono backend and React frontend.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend",
    "dev:backend": "bun --watch --tsconfig-override ./server/tsconfig.json server/src/app.ts",
    "dev:frontend": "vite",
    "start": "NODE_ENV=production bun --tsconfig-override ./server/tsconfig.json server/src/app.ts",
    "build": "bun run build:backend && bun run build:frontend",
    "build:backend": "tsc --project server/tsconfig.json --noEmit",
    "build:frontend": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test ./test",
    "check": "biome check --write src server/src shared vite.config.ts && bun run build:backend && tsc -b",
    "check:backend": "biome check server/src shared && bun run build:backend",
    "lint": "biome lint src server/src shared vite.config.ts",
    "lint:frontend": "biome lint src vite.config.ts",
    "format": "biome format --write src server/src shared vite.config.ts",
    "db:up": "bun run docker:dev:up",
    "db:down": "bun run docker:dev:down",
    "db:logs": "docker compose --env-file .env -f docker/docker-compose.dev.yml logs -f postgres",
    "db:start": "bun run db:up",
    "db:stop": "bun run db:down",
    "db:generate": "bun --bun prisma generate --config server/prisma.config.ts",
    "db:migrate": "bun run db:migrate:dev",
    "db:migrate:dev": "bun --bun prisma migrate dev --config server/prisma.config.ts",
    "db:migrate:deploy": "bun --bun prisma migrate deploy --config server/prisma.config.ts",
    "db:migrate:reset": "bun --bun prisma migrate reset --config server/prisma.config.ts",
    "db:seed": "bun --bun prisma db seed --config server/prisma.config.ts",
    "db:create-admin": "bun --tsconfig-override ./server/tsconfig.json server/src/db/create-admin.ts",
    "db:studio": "bun --bun prisma studio --config server/prisma.config.ts",
    "docker:dev:up": "docker compose --env-file .env -f docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose --env-file .env -f docker/docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose --env-file .env -f docker/docker-compose.dev.yml logs -f",
    "docker:prod:up": "docker compose --env-file .env -p zappaz-prod -f docker/docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose --env-file .env -p zappaz-prod -f docker/docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file .env -p zappaz-prod -f docker/docker-compose.prod.yml logs -f",
    "docker:build": "docker build -t zappaz-api -f docker/Dockerfile .",
    "docker:run": "docker run -p 127.0.0.1:3001:3001 --env-file .env zappaz-api"
  },
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
